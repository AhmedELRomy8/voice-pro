{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "voice-pro",
  "version": "1.0.0",
  "identifier": "com.voicepro.tools",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Voice & Document Tools | أدوات الصوت والمستندات",
        "width": 1150,
        "height": 800,
        "minWidth": 780,
        "minHeight": 580,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
